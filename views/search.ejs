<div class="author">
<h1 class="author_heading">Search results</h1>
</div>
<section class="articles">
    <ul class="articles_ul">
        <% data.forEach(post =>{ %>                 
        <li>
            <a href="/post/<%= post._id %>" target="_blank" >
            <span><%= post.title %></span>
            <span class="article_date"><%= post.createdAt.toDateString() %></span>
        </a>
         </li>
         <% }) %>
    </ul>
</section>