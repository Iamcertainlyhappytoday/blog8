<h1>Home</h1>

<div class="author">
    <h2 class="author__heading">Hi, it's jim</h2>
    <p class="author__body">Making blogs faster</p>
    <!--&lt%- data %&rt-->
    <div id="milantower">
        <figure class="hundred">
        <figcaption>holiday snaps</figcaption>
        <img src="/img/meonhol.JPG" alt="holidaysnap"
        class="author__image" >
        </figure>
    </div>
</div>

<section class="articles">
    <h2 class="article__heading">Latest posts</h2>

    <ul class="articles_ul">
        <% data.forEach(post =>{ %>                 
        <li>
            <a href="/post/<%= post._id %>" target="_blank" >
            <span><%= post.title %></span>
            <span class="article_date"><%= post.createdAt.toDateString() %></span>
        </a>
         </li>
         <% }) %>
       
       <!-- <li><a href="">
            <span>Post titles</span>
            <span class="article_date">Date</span>
        </a>
        </li>
        <li><a href="">
            <span>Post titles</span>
            <span class="article_date">Date</span>
        </a>
        </li>-->
    </ul>
    <div class="row">
       <% if(prevPage !== null) { %> 
        <a href="/?page=<%= prevPage %>" class="pagination"> view newer posts</a>
    <% } %>    
    <% if(nextPage !== null) { %> 
        <a href="/?page=<%= nextPage %>"  class="pagination"> view older posts</a>
    <% } %>
  
    </div>
</section>